type": "City", "name": "Scotch Plains"}, {"@type": "City", "name": "Secaucus"}, {"@type": "City", "name": "Somerville"}, {"@type": "City", "name": "South Brunswick"}, {"@type": "City", "name": "South Orange"}, {"@type": "City", "name": "Sparta"}, {"@type": "City", "name": "Stafford"}, {"@type": "City", "name": "Summit"}, {"@type": "City", "name": "Teaneck"}, {"@type": "City", "name": "Tinton Falls"}, {"@type": "City", "name": "Toms River"}, {"@type": "City", "name": "Trenton"}, {"@type": "City", "name": "Union"}, {"@type": "City", "name": "Vernon"}, {"@type": "City", "name": "Vineland"}, {"@type": "City", "name": "Voorhees"}, {"@type": "City", "name": "Wall"}, {"@type": "City", "name": "Wayne"}, {"@type": "City", "name": "West Milford"}, {"@type": "City", "name": "West New York"}, {"@type": "City", "name": "West Orange"}, {"@type": "City", "name": "Westfield"}, {"@type": "City", "name": "Willingboro"}, {"@type": "City", "name": "Winslow"}, {"@type": "City", "name": "Woodbridge"}], "audience": {"@type": "PeopleAudience", "suggestedMaxAge": 5}, "url": "https://www.mastermindbehavior.com/early-intervention-new-jersey"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is this the same as NJEIS?", "acceptedAnswer": {"@type": "Answer", "text": "No. NJEIS is New Jersey's public early intervention program for children under three, run by the Department of Health. We are a private in-home ABA provider funded through your health coverage. Families often use both at the same time."}}, {"@type": "Question", "name": "What happens when my child turns three?", "acceptedAnswer": {"@type": "Answer", "text": "NJEIS ends at the third birthday, and preschool special education through your school district begins if your child qualifies. In-home ABA is funded through your coverage rather than through either system, so it can continue across that transition without a break."}}, {"@type": "Question", "name": "Do we need a diagnosis before starting ABA?", "acceptedAnswer": {"@type": "Answer", "text": "Coverage for ABA under New Jersey's mandate and NJ FamilyCare follows an autism diagnosis. If you do not have one yet, the mandate also covers diagnostic assessments, and a consultation is a good place to talk through the path."}}, {"@type": "Question", "name": "How young is too young?", "acceptedAnswer": {"@type": "Answer", "text": "Early intervention is built for the youngest children. Children who begin before age five consistently show the greatest gains, and if you are unsure whether it is time, that question is exactly what a free consultation is for."}}, {"@type": "Question", "name": "Will I be involved in sessions?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Parent coaching is part of the model. You will learn the strategies your child's team uses, so progress continues between sessions instead of pausing when the Behavior Technician leaves."}}, {"@type": "Question", "name": "How soon can we start?", "acceptedAnswer": {"@type": "Answer", "text": "There is no onboarding waitlist. Assessment takes about four weeks."}}]}]}