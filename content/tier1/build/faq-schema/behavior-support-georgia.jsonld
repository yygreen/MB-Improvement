{"@context": "https://schema.org", "@graph": [{"@context": "https://schema.org", "@type": "Service", "name": "Behavior Support ABA Therapy in Georgia", "serviceType": "Applied Behavior Analysis behavior support", "provider": {"@type": "Organization", "name": "Mastermind Behavior", "telephone": "+1-732-813-7333", "url": "https://www.mastermindbehavior.com"}, "areaServed": [{"@type": "State", "name": "Georgia"}, {"@type": "City", "name": "Acworth"}, {"@type": "City", "name": "Adel"}, {"@type": "City", "name": "Alma"}, {"@type": "City", "name": "Americus"}, {"@type": "City", "name": "Bainbridge"}, {"@type": "City", "name": "Baxley"}, {"@type": "City", "name": "Blackshear"}, {"@type": "City", "name": "Blakely"}, {"@type": "City", "name": "Brunswick"}, {"@type": "City", "name": "Buford"}, {"@type": "City", "name": "Cairo"}, {"@type": "City", "name": "Calhoun"}, {"@type": "City", "name": "Camilla"}, {"@type": "City", "name": "Cleveland"}, {"@type": "City", "name": "College Park"}, {"@type": "City", "name": "Conyers"}, {"@type": "City", "name": "Cordele"}, {"@type": "City", "name": "Cornelia"}, {"@type": "City", "name": "Covington"}, {"@type": "City", "name": "Cumming"}, {"@type": "City", "name": "Cuthbert"}, {"@type": "City", "name": "Dahlonega"}, {"@type": "City", "name": "Dallas"}, {"@type": "City", "name": "Dawson"}, {"@type": "City", "name": "Dawsonville"}, {"@type": "City", "name": "Donalsonville"}, {"@type": "City", "name": "Douglas"}, {"@type": "City", "name": "Dublin"}, {"@type": "City", "name": "Eastman"}, {"@type": "City", "name": "Eatonton"}, {"@type": "City", "name": "Fairburn"}, {"@type": "City", "name": "Fayetteville"}, {"@type": "City", "name": "Fitzgerald"}, {"@type": "City", "name": "Folkston"}, {"@type": "City", "name": "Forest Park"}, {"@type": "City", "name": "Forsyth"}, {"@type": "City", "name": "Hartwell"}, {"@type": "City", "name": "Hawkinsville"}, {"@type": "City", "name": "Hazlehurst"}, {"@type": "City", "name": "Homerville"}, {"@type": "City", "name": "Jackson"}, {"@type": "City", "name": "Jefferson"}, {"@type": "City", "name": "Jesup"}, {"@type": "City", "name": "Kingsland"}, {"@type": "City", "name": "LaFayette"}, {"@type": "City", "name": "Lakeland"}, {"@type": "City", "name": "Lithia Springs"}, {"@type": "City", "name": "Louisville"}, {"@type": "City", "name": "Macon"}, {"@type": "City", "name": "Manchester"}, {"@type": "City", "name": "Milledgeville"}, {"@type": "City", "name": "Monroe"}, {"@type": "City", "name": "Nashville"}, {"@type": "City", "name": "Norcross"}, {"@type": "City", "name": "Pelham"}, {"@type": "City", "name": "Perry"}, {"@type": "City", "name": "Perry"}, {"@type": "City", "name": "Pooler"}, {"@type": "City", "name": "Powder Springs"}, {"@type": "City", "name": "Quitman"}, {"@type": "City", "name": "Richmond Hill"}, {"@type": "City", "name": "Ringgold"}, {"@type": "City", "name": "Riverdale"}, {"@type": "City", "name": "Sandersville"}, {"@type": "City", "name": "Savannah"}, {"@type": "City", "name": "Snellville"}, {"@type": "City", "name": "St. Marys"}, {"@type": "City", "name": "Suwanee"}, {"@type": "City", "name": "Swainsboro"}, {"@type": "City", "name": "Thomaston"}, {"@type": "City", "name": "Thomasville"}, {"@type": "City", "name": "Tifton"}, {"@type": "City", "name": "Toccoa"}, {"@type": "City", "name": "Vidalia"}, {"@type": "City", "name": "Villa Rica"}, {"@type": "City", "name": "Warner Robins"}, {"@type": "City", "name": "Waycross"}, {"@type": "City", "name": "Winder"}], "audience": {"@type": "PeopleAudience", "suggestedMaxAge": 21}, "url": "https://www.mastermindbehavior.com/behavior-support-georgia"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is a functional behavior assessment?", "acceptedAnswer": {"@type": "Answer", "text": "A structured way of finding out what a behavior is doing for your child. We observe and collect data on what happens before and after the behavior until the pattern is clear, and the intervention plan is built on that evidence."}}, {"@type": "Question", "name": "Is behavior support covered by insurance in Georgia?", "acceptedAnswer": {"@type": "Answer", "text": "Behavior support is delivered as ABA therapy, which Ava's Law requires most state-regulated plans to cover. Georgia Medicaid covers ABA for individuals under 21. The coverage table above has the detail."}}, {"@type": "Question", "name": "My child already has a behavior plan at school. Is this the same thing?", "acceptedAnswer": {"@type": "Answer", "text": "No. The school's plan is built for the school day. Ours is built for your home and your routines, and the two can inform each other. Findings from a home assessment can be shared with the school team."}}, {"@type": "Question", "name": "Do you use punishment?", "acceptedAnswer": {"@type": "Answer", "text": "The plan is built on the least restrictive, most positive strategies available. The core of the work is teaching skills that make the behavior unnecessary, and reinforcing them."}}, {"@type": "Question", "name": "Who writes the plan?", "acceptedAnswer": {"@type": "Answer", "text": "A Board Certified Behavior Analyst who also holds a current Georgia behavior analyst license. Behavior Technicians deliver day-to-day sessions under that BCBA's supervision."}}, {"@type": "Question", "name": "How soon can we start?", "acceptedAnswer": {"@type": "Answer", "text": "There is no onboarding waitlist. Assessment takes about four weeks."}}]}]}