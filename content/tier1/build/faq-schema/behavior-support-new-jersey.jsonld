": "City", "name": "Scotch Plains"}, {"@type": "City", "name": "Secaucus"}, {"@type": "City", "name": "Somerville"}, {"@type": "City", "name": "South Brunswick"}, {"@type": "City", "name": "South Orange"}, {"@type": "City", "name": "Sparta"}, {"@type": "City", "name": "Stafford"}, {"@type": "City", "name": "Summit"}, {"@type": "City", "name": "Teaneck"}, {"@type": "City", "name": "Tinton Falls"}, {"@type": "City", "name": "Toms River"}, {"@type": "City", "name": "Trenton"}, {"@type": "City", "name": "Union"}, {"@type": "City", "name": "Vernon"}, {"@type": "City", "name": "Vineland"}, {"@type": "City", "name": "Voorhees"}, {"@type": "City", "name": "Wall"}, {"@type": "City", "name": "Wayne"}, {"@type": "City", "name": "West Milford"}, {"@type": "City", "name": "West New York"}, {"@type": "City", "name": "West Orange"}, {"@type": "City", "name": "Westfield"}, {"@type": "City", "name": "Willingboro"}, {"@type": "City", "name": "Winslow"}, {"@type": "City", "name": "Woodbridge"}], "audience": {"@type": "PeopleAudience", "suggestedMaxAge": 21}, "url": "https://www.mastermindbehavior.com/behavior-support-new-jersey"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is a functional behavior assessment?", "acceptedAnswer": {"@type": "Answer", "text": "A structured way of finding out what a behavior is doing for your child. We observe and collect data on what happens before and after the behavior until the pattern is clear, and the intervention plan is built on that evidence."}}, {"@type": "Question", "name": "Is behavior support covered by insurance in New Jersey?", "acceptedAnswer": {"@type": "Answer", "text": "Behavior support is delivered as ABA therapy, which New Jersey's mandate requires most regulated plans to cover. NJ FamilyCare covers ABA for children under 21. The coverage table above has the detail for New Jersey."}}, {"@type": "Question", "name": "My child already has a behavior plan at school. Is this the same thing?", "acceptedAnswer": {"@type": "Answer", "text": "No. The school's plan is built for the school day. Ours is built for your home and your routines, and the two can inform each other. Findings from a home assessment can be shared with the school team."}}, {"@type": "Question", "name": "Do you use punishment?", "acceptedAnswer": {"@type": "Answer", "text": "The plan is built on the least restrictive, most positive strategies available. The core of the work is teaching skills that make the behavior unnecessary, and reinforcing them."}}, {"@type": "Question", "name": "Who writes the plan?", "acceptedAnswer": {"@type": "Answer", "text": "A Board Certified Behavior Analyst who is also licensed in New Jersey as an LBA. Behavior Technicians deliver day-to-day sessions under that BCBA's supervision."}}, {"@type": "Question", "name": "How soon can we start?", "acceptedAnswer": {"@type": "Answer", "text": "There is no onboarding waitlist. Assessment takes about four weeks."}}]}]}