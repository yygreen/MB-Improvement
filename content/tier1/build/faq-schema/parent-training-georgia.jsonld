{"@context": "https://schema.org", "@graph": [{"@context": "https://schema.org", "@type": "Service", "name": "ABA Parent Training in Georgia", "serviceType": "Applied Behavior Analysis parent training", "provider": {"@type": "Organization", "name": "Mastermind Behavior", "telephone": "+1-732-813-7333", "url": "https://www.mastermindbehavior.com"}, "areaServed": [{"@type": "State", "name": "Georgia"}, {"@type": "City", "name": "Acworth"}, {"@type": "City", "name": "Adel"}, {"@type": "City", "name": "Alma"}, {"@type": "City", "name": "Americus"}, {"@type": "City", "name": "Bainbridge"}, {"@type": "City", "name": "Baxley"}, {"@type": "City", "name": "Blackshear"}, {"@type": "City", "name": "Blakely"}, {"@type": "City", "name": "Brunswick"}, {"@type": "City", "name": "Buford"}, {"@type": "City", "name": "Cairo"}, {"@type": "City", "name": "Calhoun"}, {"@type": "City", "name": "Camilla"}, {"@type": "City", "name": "Cleveland"}, {"@type": "City", "name": "College Park"}, {"@type": "City", "name": "Conyers"}, {"@type": "City", "name": "Cordele"}, {"@type": "City", "name": "Cornelia"}, {"@type": "City", "name": "Covington"}, {"@type": "City", "name": "Cumming"}, {"@type": "City", "name": "Cuthbert"}, {"@type": "City", "name": "Dahlonega"}, {"@type": "City", "name": "Dallas"}, {"@type": "City", "name": "Dawson"}, {"@type": "City", "name": "Dawsonville"}, {"@type": "City", "name": "Donalsonville"}, {"@type": "City", "name": "Douglas"}, {"@type": "City", "name": "Dublin"}, {"@type": "City", "name": "Eastman"}, {"@type": "City", "name": "Eatonton"}, {"@type": "City", "name": "Fairburn"}, {"@type": "City", "name": "Fayetteville"}, {"@type": "City", "name": "Fitzgerald"}, {"@type": "City", "name": "Folkston"}, {"@type": "City", "name": "Forest Park"}, {"@type": "City", "name": "Forsyth"}, {"@type": "City", "name": "Hartwell"}, {"@type": "City", "name": "Hawkinsville"}, {"@type": "City", "name": "Hazlehurst"}, {"@type": "City", "name": "Homerville"}, {"@type": "City", "name": "Jackson"}, {"@type": "City", "name": "Jefferson"}, {"@type": "City", "name": "Jesup"}, {"@type": "City", "name": "Kingsland"}, {"@type": "City", "name": "LaFayette"}, {"@type": "City", "name": "Lakeland"}, {"@type": "City", "name": "Lithia Springs"}, {"@type": "City", "name": "Louisville"}, {"@type": "City", "name": "Macon"}, {"@type": "City", "name": "Manchester"}, {"@type": "City", "name": "Milledgeville"}, {"@type": "City", "name": "Monroe"}, {"@type": "City", "name": "Nashville"}, {"@type": "City", "name": "Norcross"}, {"@type": "City", "name": "Pelham"}, {"@type": "City", "name": "Perry"}, {"@type": "City", "name": "Perry"}, {"@type": "City", "name": "Pooler"}, {"@type": "City", "name": "Powder Springs"}, {"@type": "City", "name": "Quitman"}, {"@type": "City", "name": "Richmond Hill"}, {"@type": "City", "name": "Ringgold"}, {"@type": "City", "name": "Riverdale"}, {"@type": "City", "name": "Sandersville"}, {"@type": "City", "name": "Savannah"}, {"@type": "City", "name": "Snellville"}, {"@type": "City", "name": "St. Marys"}, {"@type": "City", "name": "Suwanee"}, {"@type": "City", "name": "Swainsboro"}, {"@type": "City", "name": "Thomaston"}, {"@type": "City", "name": "Thomasville"}, {"@type": "City", "name": "Tifton"}, {"@type": "City", "name": "Toccoa"}, {"@type": "City", "name": "Vidalia"}, {"@type": "City", "name": "Villa Rica"}, {"@type": "City", "name": "Warner Robins"}, {"@type": "City", "name": "Waycross"}, {"@type": "City", "name": "Winder"}], "audience": {"@type": "Audience", "audienceType": "Parents and caregivers"}, "url": "https://www.mastermindbehavior.com/parent-training-georgia"}, {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is parent training covered by insurance in Georgia?", "acceptedAnswer": {"@type": "Answer", "text": "When it is part of your child's ABA treatment plan, it is typically covered as part of ABA therapy. Ava's Law requires most state-regulated plans to cover ABA, and Georgia Medicaid covers ABA for individuals under 21. We check your specific plan with you before starting."}}, {"@type": "Question", "name": "Do both parents have to participate?", "acceptedAnswer": {"@type": "Answer", "text": "We coach the people who are actually in the routines. For some families that is one parent. For others it is both, a grandparent, or another caregiver. The goal is consistency across the adults your child spends time with."}}, {"@type": "Question", "name": "Is this a class?", "acceptedAnswer": {"@type": "Answer", "text": "No. There is no curriculum binder and no classroom. It is one-to-one coaching in your own home, during your own routines, on the specific situations you face."}}, {"@type": "Question", "name": "My child already receives ABA. Why add this?", "acceptedAnswer": {"@type": "Answer", "text": "Because your child's week has far more hours in it than any therapy schedule. When the adults at home use the same prompts, reinforcement, and structured routines as the session team, skills generalize instead of staying locked to sessions."}}, {"@type": "Question", "name": "What if a strategy does not work for us?", "acceptedAnswer": {"@type": "Answer", "text": "That is information, not failure. Your BCBA adjusts the plan based on what the data and your experience show. The program serves your family, not the other way around."}}, {"@type": "Question", "name": "How soon can we start?", "acceptedAnswer": {"@type": "Answer", "text": "There is no onboarding waitlist. Assessment takes about four weeks."}}]}]}